# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publique (sans / final) : robots.txt, sitemap, aperçus de lien (OpenGraph).
# ⚠ Le domaine imprimé DANS LES QR se règle ailleurs : Admin → Cités → Réglages.
NEXT_PUBLIC_SITE_URL=https://awa-songon.vercel.app

# Mesure d'audience Google Analytics 4 (facultatif, format G-XXXXXXX).
# Vide = aucun traceur et aucun bandeau cookies.
NEXT_PUBLIC_GA_ID=

# Redirige http:// vers https:// (301). Inutile sur Vercel (déjà fait). Ne pas
# activer sans HTTPS devant : boucle de redirection.
FORCE_HTTPS=false

# Chemins secrets (8 à 64 caractères, lettres/chiffres/-/_). Génère les tiens :
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# Cockpit admin (2FA exigée en plus) :
ADMIN_PATH=cockpit-remplace-moi
# Espace livreur (le lien envoyé aux livreurs) :
DRIVER_PATH=livreur-remplace-moi
# Inscription des chauffeurs recrutés (validés ensuite par l'admin) :
DRIVER_SIGNUP_PATH=recrutement-remplace-moi
