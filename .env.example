# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Mode démo (données dans le navigateur, sans Supabase). TOUJOURS false en production :
# un build de prod avec true échoue, sauf ALLOW_DEMO_BUILD=true (site de démo assumé).
NEXT_PUBLIC_DEMO_MODE=false
# Uniquement en démo : identifiants du compte admin fictif (aucun par défaut).
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
# NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=

# Chemins secrets aléatoires (8 à 64 caractères, lettres/chiffres/-/_).
# Génère les tiens : node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# Liens à partager à la main :
# - inscription chauffeur (recrutement) :
DRIVER_SIGNUP_PATH=inscription-chauffeur-remplace-moi
# - connexion admin (email + mot de passe) :
ADMIN_LOGIN_PATH=admin-acces-remplace-moi
# Espaces après connexion (aucun ne doit contenir un autre chemin) :
DRIVER_PATH=chauffeur-remplace-moi
ADMIN_PATH=cockpit-remplace-moi
# Les dossiers réels (/admin, /chauffeur, /acces-admin, /recrutement-chauffeur) répondent 404.

# URL publique (sans / final) : robots.txt, sitemap, aperçus de lien (OpenGraph).
# À changer au passage sur le domaine .com.
NEXT_PUBLIC_SITE_URL=https://awa-songon.vercel.app

# Mesure d'audience Google Analytics 4 (facultatif, format G-XXXXXXX).
# Vide = aucun traceur et aucun bandeau cookies. Défini = bandeau de consentement,
# gtag chargé seulement après « Accepter ».
NEXT_PUBLIC_GA_ID=

# Redirige http:// vers https:// (301). Inutile sur Vercel (déjà fait), utile derrière
# un autre hébergeur avec proxy HTTPS. Ne pas activer sans HTTPS devant : boucle.
FORCE_HTTPS=false
